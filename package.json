{
  "name": "create-adonisjs",
  "description": "Scaffold new AdonisJS applications using starter kits",
  "version": "3.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin/test.js",
    "!build/tests",
    "!build/tests_helpers"
  ],
  "bin": {
    "create-adonisjs": "build/bin/run.js"
  },
  "exports": {
    ".": "./build/index.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "cross-env NODE_DEBUG=create-adonisjs npm run quick:test",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" --up=\"1\" build",
    "clean": "del-cli build",
    "precompile": "npm run lint && npm run clean",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "docs": "typedoc",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^25.3.0",
    "@types/which-pm-runs": "^1.0.2",
    "c8": "^11.0.0",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "release-it": "19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@adonisjs/ace": "^14.0.1",
    "execa": "^9.6.1",
    "giget": "^3.1.2",
    "gradient-string": "^3.0.0",
    "which-pm-runs": "^1.1.0"
  },
  "homepage": "https://github.com/adonisjs/create-adonisjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/create-adonisjs.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/create-adonisjs/issues"
  },
  "keywords": [
    "adonisjs",
    "create-adonisjs-app"
  ],
  "author": "Harminder Virk <virk@adonisjs.com>",
  "contributors": [
    "julien-r44"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsup": {
    "entry": [
      "./index.ts",
      "./bin/run.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "stubs/**",
      "factories/**",
      "bin/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
